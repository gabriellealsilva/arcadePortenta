	(text "VSD: module V-SDCARD pad feeds SD socket VDD.\nClose JP100 only if V-SDCARD turns out not to source 3V3 (verify against Portenta schematic before closing!)"
		(exclude_from_sim no)
		(at 294.64 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2578db15-c749-46aa-8eb1-b34ab9e5ee80")
	)
	(text "Arduino Portenta H7 high-density connectors.\nPin map verified against ABX00042 full-pinout PDF (13/11/2024), Arduino_PortentaBreakout lib and STM32H747XIH6 CubeMX DB.\nPads marked Px* share an MCU ball with another pad (dual bond) - twin left NC:\n  PB3 = J1-63 (SD_D2) = J1-79 (SWO): SWO unavailable.\n  PA0 = J1-34 (IN_LATCH) = J2-73 (A0).  PA4 = J2-22 (VSYNC) = J2-78.\n  PC2 = J2-40 = J2-74.  PC3 = J2-42 = J2-76.  PH11 = J2-12 = J2-47.\n  PH12 = J2-10 = J2-45.  PI5 = J2-18 = J2-49.  PI6 = J2-4 = J2-53.  PI7 = J2-2 = J2-51.\nJ1-43/45 (I2C1) shared with on-module PMIC - leave NC."
		(exclude_from_sim no)
		(at 34.798 204.47 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "26285984-d2ad-404c-b56e-ad42bddf80e3")
	)
	(text "SWO not available (PB3 used as SD_D2)"
