	(text "Coin counter (DNP): PE3 -> Q300 low-side, flyback to +12V (counter coil supply)."
		(exclude_from_sim no)
		(at 90 235 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9b355282-2144-47eb-8308-96280c5774e4")
	)
	(text "Chain order: U300 shifts first (P1), U303 last (aux).\nPoll at 1 kHz: latch low pulse, then 32 clocks on IN_CLK, read IN_DATA."
		(exclude_from_sim no)
		(at 300 420 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "a1fa79d3-2e23-47ef-89df-56af6ec65bd5")
	)
	(text "JAMMA edge: odd pins = component side 1-28, even = solder side A-f.\n3.96 mm (0.156 inch) pitch card-edge - custom footprint, part of board outline.\nButtons switch to GND; 10k pull-ups to 3V3; 1k + 100n RC per input (fc=1.6kHz, tau=1ms debounce helper).\nP1/P2 buttons 4-6 on CPS-style kick harness J9/J10; B4 also on JAMMA 25/c."
		(exclude_from_sim no)
		(at 20 20 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "afece9cf-f618-40b9-b288-3cb78fc7d387")
	)
