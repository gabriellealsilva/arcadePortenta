	)
	(text "Video DAC: binary-weighted ladders, 3.3V CMOS -> 0.7Vpp into double-terminated 75R.\nR_thevenin = 75*(3.3/0.7-1) = 278.6R; MSB = 278.6*1.9375 (5b) / *1.96875 (6b).\n1% E96. Green 6 bit, red/blue 5 bit (RGB565)."
		(exclude_from_sim no)
		(at 22.606 157.988 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "42948563-8547-4077-833a-1ca95a576597")
	)
	(text "Open JAMMA jumpers when only the DE15 is used\n(second 75R load halves video level)."
