	(text "PCM5102A: SCK=GND -> internal PLL from BCK (no MCLK needed).\nFMT=GND I2S, FLT=GND normal filter, DEMP=GND off.\nXSMT: 10k pulldown = muted at boot; PD4 drives high to unmute (pop-free start).\nOutput RC 470R+2.2nF: fc=154 kHz (-38 dB at 384fs).\nAVDD via FB1 bead; AGND via NT1 net-tie (single ground plane)."
		(exclude_from_sim no)
		(at 40 175 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "cbc68a55-e31b-4b2a-a06f-625066c4f30b")
	)
